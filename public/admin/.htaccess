# АДМИНКА: ЗАКРЫТО ВСЁ, КРОМЕ САМИХ СТРАНИЦ.
#
# От индексации админка закрыта заголовком X-Robots-Tag, который ставит сам
# PHP, и отсутствием ссылок: в robots.txt её НЕ вписываем — этот файл открыт
# всем, и строка Disallow опубликовала бы ровно тот адрес, который прячется.
# Здесь заголовок продублирован на случай, если до PHP дело не дойдёт.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# Листинга каталогов быть не должно: по нему видно состав админки.
Options -Indexes
DirectoryIndex index.php

# SQL наружу не отдаётся. Секретов в нём нет — это схема и первоначальное
# наполнение, — но состав базы посторонним знать незачем.
<FilesMatch "\.sql$">
  Require all denied
</FilesMatch>

# ОБРАЗЕЦ ФАЙЛА НАСТРОЕК ЗАКРЫТ ТОЖЕ. Настоящих доступов в нём нет, они
# лежат вне корня сайта, — но образец показывает имена ключей и путь, куда
# копию класть. Подсказывать это некому.
<FilesMatch "^cms-config">
  Require all denied
</FilesMatch>
