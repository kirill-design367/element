# НАСТРОЙКИ APACHE ДЛЯ elementst.ru
#
# Файл лежит в public/ и уезжает в корень сайта вместе с выдачей: Next
# копирует содержимое public/ в out/ целиком, включая точечные файлы.
# Держать его на сервере руками нельзя — выкладка с --delete его сотрёт.
#
# Всё, что здесь есть, GitHub Pages делал сам: сжатие, заголовки кеша, свою
# страницу 404 и переход на https. На обычном хостинге это надо объявить.

AddDefaultCharset UTF-8

# Каталог отдаётся своим index.html. В конфиге сайта стоит trailingSlash:
# адреса заканчиваются слэшем, и /catalog/ должен разрешаться в
# /catalog/index.html. Листинга каталогов быть не должно ни при каких
# условиях: в выдаче лежат чанки сборки, показывать их незачем.
DirectoryIndex index.html
Options -Indexes

# Своя страница 404 вместо апачевской «Not Found».
ErrorDocument 404 /404.html

# ────────────────────────────────────────────────────────────────────────
# Сжатие
#
# Картинки и шрифты не перечислены намеренно: WebP, JPEG и woff2 уже сжаты,
# и второй проход только греет процессор.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ────────────────────────────────────────────────────────────────────────
# Кеш
#
# Порядок правил ЗНАЧИМ: последнее совпавшее Header set перекрывает
# предыдущее. Поэтому годовой кеш /_next/static идёт последним — иначе
# правило для шрифтов забрало бы у него месяц.
<IfModule mod_headers.c>
  # HTML не кешируется: имя файла у страницы постоянное, а содержимое
  # меняется с каждой выкладкой. Закешированный html показал бы старые цены.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Изображения и шрифты — месяц. Имена у них без хеша, поэтому вечно
  # кешировать нельзя: замена кадра не дошла бы до тех, кто уже заходил.
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # robots.txt — сутки: он меняется редко, но обновление не должно ждать.
  <FilesMatch "^robots\.txt$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # /_next/static — год и immutable. Имя каждого файла содержит хеш
  # содержимого, поэтому изменённый файл приходит под другим именем, а этот
  # не изменится уже никогда. LocationMatch в .htaccess запрещён, поэтому
  # путь помечается переменной окружения.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_next/static/" NEXT_STATIC
  </IfModule>
  Header set Cache-Control "public, max-age=31536000, immutable" env=NEXT_STATIC
</IfModule>

# ────────────────────────────────────────────────────────────────────────
# Комплект логотипа
#
# /brand/element-logo.zip лежит в выдаче, чтобы заказчик мог скачать его
# одним файлом, но искать его в поиске незачем.
#
# ГЛАВНАЯ ЗАЩИТА — ОТСУТСТВИЕ ССЫЛОК: краулер находит адреса по ссылкам, а
# на архив не ссылается ни одна страница сайта. В robots.txt его намеренно
# НЕ вписываем: robots.txt открыт всем, и строка Disallow как раз и
# опубликовала бы путь, который мы прячем.
#
# Заголовок ниже — вторая линия, на случай если адрес всё же куда-то
# попадёт. Дойдёт он не наверняка: статику по расширению отдаёт nginx мимо
# Apache (см. заголовки кеша выше), и до .htaccess запрос может не добраться.
<IfModule mod_headers.c>
  <FilesMatch "\.zip$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# ────────────────────────────────────────────────────────────────────────
# Приёмник заявки
#
# /api/lead.php — единственное место, где на сервере выполняется наш код.
# Рядом с ним лежит config.php с адресом получателя: он ничего не печатает,
# а только возвращает массив, так что прямое обращение и без запрета отдало
# бы пустую страницу. Запрет ставится всё равно — на случай, если однажды
# PHP на пути окажется выключен и Apache отдаст файл исходником.
<Files "config.php">
  Require all denied
</Files>

# Ответ приёмника индивидуален и кешироваться не должен. Заголовок скрипт
# ставит и сам; здесь он продублирован на случай, если промежуточный кеш
# посмотрит только на расширение.
<IfModule mod_headers.c>
  <FilesMatch "^lead\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# ────────────────────────────────────────────────────────────────────────
# Единственный адрес сайта
#
# Канонический вариант — БЕЗ www. Он короче, и все внутренние ссылки на
# сайте относительные, так что выбор ни на что, кроме адресной строки, не
# влияет. Важно, что вариант один: два адреса у одного сайта делят между
# собой поисковый вес и путают статистику.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.elementst.ru → elementst.ru, СРАЗУ НА https. Раньше здесь
  # сохранялась схема — сертификата не было. Теперь сохранять её нельзя:
  # http://www.… отдал бы 301 на http://… , а тот следом ещё один 301 на
  # https. Два редиректа подряд там, где хватает одного.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # ПРИНУДИТЕЛЬНЫЙ HTTPS. Включён 29.08, когда Let's Encrypt для домена был
  # выпущен и привязан. До этого блок стоял закомментированным: на 443
  # отвечала самоподписанная заглушка хостинга, и переход показывал бы
  # посетителю предупреждение браузера вместо сайта.
  #
  # ДВЕ ПРОВЕРКИ, А НЕ ОДНА, и это не перестраховка. Спереди стоит nginx, и
  # Apache видит соединение от него как незашифрованное: %{HTTPS} у него
  # всегда off, сколько бы посетитель ни пришёл по https. О настоящей схеме
  # говорит только заголовок X-Forwarded-Proto. С одной проверкой правило
  # срабатывало бы и на уже защищённом запросе — получилась бы бесконечная
  # петля редиректов.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
